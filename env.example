# =============================================================================
# Image Master — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file MUST NOT be committed to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# API Keys & Base URLs (required for real provider calls)
# ---------------------------------------------------------------------------

# Global fallback — used when per-model keys are not set
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Vision model — multi-modal, used for product image analysis
VISION_MODEL=gpt-4o
# VISION_API_KEY=          # falls back to OPENAI_API_KEY
# VISION_BASE_URL=         # falls back to OPENAI_BASE_URL

# Image generation model
IMAGE_MODEL=dall-e-3
# IMAGE_API_KEY=           # falls back to OPENAI_API_KEY
# IMAGE_BASE_URL=          # falls back to OPENAI_BASE_URL

# Text model — used for planning, prompt writing, and canvas composition
TEXT_MODEL=gpt-4o
# TEXT_API_KEY=            # falls back to OPENAI_API_KEY
# TEXT_BASE_URL=           # falls back to OPENAI_BASE_URL

# ---------------------------------------------------------------------------
# Data & Storage
# ---------------------------------------------------------------------------

# Root directory for SQLite database and generated images
# Default: .data/ (relative to project root)
# IMAGE_MASTER_DATA_DIR=.data

# Max size for a single generated image written to local storage (MB, default: 64)
# IMAGE_MASTER_MAX_OUTPUT_FILE_MB=64

# ---------------------------------------------------------------------------
# Job Queue (background image generation worker)
# ---------------------------------------------------------------------------

# Max concurrent image generation jobs running at once (default: 10)
# IMAGE_MASTER_JOB_CONCURRENCY=10

# How long a job lease lasts before it's considered stale (ms, default: 300000 = 5 min)
# IMAGE_MASTER_JOB_LEASE_MS=300000

# Interval for the stale-job reclaim worker (ms, default: half of lease)
# IMAGE_MASTER_JOB_RECLAIM_INTERVAL_MS=150000

# Owner label for this queue worker (default: auto-generated pid+uuid)
# IMAGE_MASTER_QUEUE_OWNER=

# ---------------------------------------------------------------------------
# Provider Call Limits & Retries
# ---------------------------------------------------------------------------

# Max images per single batch generation request (default: 10)
# IMAGE_MASTER_MAX_BATCH_IMAGES=10

# Timeout for a single image generation HTTP call (ms, default: 900000 = 15 min)
# IMAGE_MASTER_IMAGE_TIMEOUT_MS=900000

# ---------------------------------------------------------------------------
# AI Planner / Prompt Writer
# ---------------------------------------------------------------------------

# Real generation first asks the asset invocation planner which uploaded
# product/model/scene/style/copy assets should be used for each shot.
# Set to "1" only for emergency fallback/debugging.
# IMAGE_MASTER_DISABLE_ASSET_INVOCATION_PLANNER=1

# Real generation also asks a plan-level Agent to decide the overall asset
# relationship matrix, e.g. one model + many products + many scenes.
# Set to "1" only for emergency fallback/debugging.
# IMAGE_MASTER_DISABLE_AGENT_PLAN_LLM=1

# Plan-level Agent output budget. Raise this only if valid structured plans are
# being truncated by the text model.
# IMAGE_MASTER_AGENT_PLAN_MAX_TOKENS=6000

# Max concurrent per-shot plan preparation calls inside /api/generation-plans/run.
# This controls asset invocation planning and AI prompt writing for large batches.
# Keep moderate to avoid rate limits; raise for local stress tests.
# IMAGE_MASTER_PLAN_JOB_PREP_CONCURRENCY=4

# Per-shot asset invocation planner output budget. Raise if the planner returns
# truncated JSON for complex multi-asset shots.
# IMAGE_MASTER_ASSET_INVOCATION_PLANNER_MAX_TOKENS=2000

# Real asset invocation planning should fail loudly when the planner fails.
# Set to "1" only for emergency demos where continuing is more important than
# proving the reference-routing Agent worked.
# IMAGE_MASTER_ALLOW_ASSET_INVOCATION_FALLBACK=1

# By default, a failed plan-level Agent call should fail loudly instead of
# silently falling back to deterministic planning. Set to "1" only for emergency
# demos where continuing is more important than proving Agent planning worked.
# IMAGE_MASTER_ALLOW_AGENT_PLAN_FALLBACK=1

# Real generation is LLM-first: the AI prompt writer turns selected skills/SOP,
# reference roles, and the current shot into the provider prompt.
# Set to "1" only for smoke tests, emergency fallback, or debugging the legacy
# rule compiler without extra text-LLM cost.
# IMAGE_MASTER_DISABLE_AI_PROMPT_WRITER=1

# ---------------------------------------------------------------------------
# Provider Circuit Breaker
# ---------------------------------------------------------------------------

# Number of consecutive failures before the circuit opens (default: 3)
# IMAGE_MASTER_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3

# Cooldown duration after circuit opens (ms, default: 60000 = 1 min)
# IMAGE_MASTER_PROVIDER_CIRCUIT_COOLDOWN_MS=60000

# ---------------------------------------------------------------------------
# Mock / Testing Mode (no real provider calls)
# ---------------------------------------------------------------------------

# Enable mock batch image generation (returns fake PNG instead of calling API)
# IMAGE_MASTER_ENABLE_MOCK_BATCH=1

# Enable mock job runner (in-process jobs return fake PNG)
# IMAGE_MASTER_ENABLE_MOCK_JOB_RUNNER=1

# When mock job runner is on, require at least one reference image
# IMAGE_MASTER_MOCK_JOB_RUNNER_REQUIRE_REFERENCE=1

# When mock job runner is on, verify exact reference count
# IMAGE_MASTER_MOCK_JOB_RUNNER_EXPECT_REFERENCE_COUNT=2
